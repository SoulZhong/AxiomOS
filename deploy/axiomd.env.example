# AxiomOS 生产环境变量。deploy/setup-server.sh 第一次运行时会按这份模板生成 /etc/axiomos/axiomd.env，
# 并把标着「生成」的值换成随机值；之后要改直接编辑那个文件，然后 sudo systemctl restart axiomd。
# 这个文件只有 root 与 axiomos 用户可读（0640）。

# 监听地址：只听本机，对外由 Nginx 转发
ADDR=127.0.0.1:8080

# 静态前端目录（发布包里的 web/）
WEB_DIR=/opt/axiomos/current/web

# 对外地址：邀请链接、通知里的直达链接、接入链接都用它拼
PUBLIC_URL=https://axiom.tutorkin.com

# 浏览器跨域允许的来源；前端与后端同源时填公网地址即可
ALLOW_ORIGINS=https://axiom.tutorkin.com

# 会话 Cookie 只在 HTTPS 下发（生产必须为 1）
SECURE_COOKIE=1

# 数据库（密码由 setup-server.sh 生成，与 /etc/axiomos/db.env 里的一致）
DATABASE_URL=postgres://axiomos:【生成】@127.0.0.1:5439/axiomos?sslmode=disable

# 组织凭据（IM 集成的 App Secret、代码平台令牌等）的加密密钥：32 字节，base64。丢了就解不开已存的凭据，务必备份
AXIOMOS_SECRET_KEY=【生成】

# 平台管理员（后台 /admin/）。首次启动创建；之后改密码在后台改，这里改了不会覆盖
PLATFORM_ADMIN_EMAIL=admin@tutorkin.com
PLATFORM_ADMIN_PASSWORD=【生成】
PLATFORM_ADMIN_NAME=平台管理员

# 演示组织：公网实例不要开（演示账号密码是公开的）。要看演示数据在本地 make run
SEED_DEMO=0

# 出网守卫：公网实例保持关闭（内网、回环、云元数据地址一律拒绝）；私有化部署要接内网 GitLab 时才设 1
# AXIOMOS_ALLOW_PRIVATE_EGRESS=0

# 邮件通道的服务端默认（组织没填 SMTP 时用它；可不配）
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# SMTP_FROM=AxiomOS <no-reply@tutorkin.com>
